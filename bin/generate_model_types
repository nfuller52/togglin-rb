#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"

require "active_support/inflector"
require "fileutils"

OUTPUT_FILE = Rails.root.join("app", "frontend", "src", "data", "api", "internal", "types.ts")
FileUtils.mkdir_p(OUTPUT_FILE.dirname) unless Dir.exist?(OUTPUT_FILE)

TYPE_MAP = {
  string: "string",
  integer: "number",
  float: "number",
  boolean: "boolean",
  datetime: "Date",
  date: "Date",
  time: "Date",
  text: "string",
  uuid: "string",
  json: "JSONVal | JSONVal[]",
}.freeze

Dir.glob(Rails.root.join("app/models/**/*.rb")).each do |file|
  require_dependency file
end

models = ApplicationRecord.descendants.select do |model|
  model.const_defined?(:SERIALIZER_PROFILES)
end

File.open(OUTPUT_FILE, "w") do |f|
  f.puts <<~HEADER
    // This file is auto-generated by bin/generate_model_types. Do not edit directly.
    // Run `bin/generate_model_types` to regenerate.

    export type JSONPrimitive = string | number | boolean | null
    export type JSONVal = JSONPrimitive | { [key: string]: JSONVal } | JSONVal[]

  HEADER

  models.sort_by(&:name).each do |model|
    model_name = model.name
    profiles = model::SERIALIZER_PROFILES

    profiles.each do |profile_name, fields|
      type_name = profile_name == :default ? model_name : "#{model_name}#{profile_name.to_s.camelize}"

      f.puts "export type #{type_name} = {"

      fields.each do |field, ruby_type|
        ts_type = TYPE_MAP[ruby_type] || "any"
        camel_name = field.to_s.camelize(:lower)
        f.puts "  #{camel_name}: #{ts_type}"
      end
      f.puts "}\n\n"
    end
  end
end
